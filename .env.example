# ── Telegram Credentials (required) ──
API_ID=12345
API_HASH=your_api_hash_here
STRING_SESSION=your_pyrogram_string_session_here
OWNER_ID=123456789

# ── Database ──
MONGO_URI=mongodb://mongodb:27017
DB_NAME=telegram_invite_bot
REDIS_URL=redis://redis:6379/0

# ── Invite Settings ──
MAX_INVITES_PER_HOUR=25
COOLDOWN_MIN=45
COOLDOWN_MAX=60
MAX_CONSECUTIVE_ERRORS=3
FLOODWAIT_LIMIT=3600

# ── Paths ──
BACKUP_DIR=backups
EXPORT_DIR=exports

# ── API Server ──
API_PORT=8000
API_HOST=0.0.0.0

# ── Localization ──
DEFAULT_LANG=en

# ── Security ──
EMERGENCY_MODE=false

# ── Reports ──
DAILY_REPORT_TIME=23:00
WEEKLY_REPORT_DAY=monday
